# ======================================================================
# 1. PÁGINAS DE ERRO PERSONALIZADAS
# ======================================================================
# Aponta os erros HTTP para os arquivos HTML que acabámos de criar.
ErrorDocument 403 /page_error/403.html
ErrorDocument 404 /page_error/404.html
ErrorDocument 500 /page_error/500.html

# ======================================================================
# 2. SEGURANÇA DE DIRETÓRIOS E ARQUIVOS
# ======================================================================
# Desativa a "Indexação de Diretórios". Se alguém aceder a uma pasta 
# sem index.php, o Apache mostra o erro 403 em vez de listar os seus arquivos.
Options -Indexes

# Oculta a assinatura do servidor (não mostra a versão do Apache/OS nos erros).
ServerSignature Off

# Bloqueia o acesso a ficheiros confidenciais (ex: .htaccess, config.php, logs)
<FilesMatch "(\.(bak|config|sql|fla|md|ini|log|sh|inc|swp|dist)|~)$">
    Require all denied
</FilesMatch>

# Bloqueia o acesso a ficheiros/pastas ocultas do sistema (como .git ou .env)
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# ======================================================================
# 3. CABEÇALHOS DE SEGURANÇA (HTTP HEADERS)
# ======================================================================
<IfModule mod_headers.c>
    # Impede que o seu sistema seja embutido em iframes de outros sites (Clickjacking)
    Header set X-Frame-Options "SAMEORIGIN"
    
    # Previne que o navegador tente adivinhar o tipo do ficheiro (MIME Sniffing)
    Header set X-Content-Type-Options "nosniff"
    
    # Ativa o filtro nativo contra injeção de scripts maliciosos (XSS)
    Header set X-XSS-Protection "1; mode=block"
    
    # Controla o quanto de informação é enviada quando clica num link externo
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ======================================================================
# 4. COMPRESSÃO GZIP / DEFLATE (AUMENTO DE VELOCIDADE)
# ======================================================================
# Comprime textos, CSS, JS e HTML antes de enviar para o navegador, 
# reduzindo drasticamente o consumo de dados móveis do utilizador.
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ======================================================================
# 5. CACHE NO NAVEGADOR (CACHE CONTROL)
# ======================================================================
# Diz ao navegador para guardar as fontes e ícones localmente. Ao trocar
# de abas no Med+, ele não precisará descarregar tudo novamente.
<IfModule mod_expires.c>
    ExpiresActive On
    
    # Imagens e Fontes: Guardar por 1 mês
    ExpiresByType image/jpg "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 month"
    
    # CSS e JS: Guardar por 1 semana
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
</IfModule>

# ======================================================================
# 6. URL AMIGÁVEL E HTTPS (OPCIONAL)
# ======================================================================
<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # 1. REDIRECIONAMENTO HTTPS
    # Quando for hospedar o sistema de vez e tiver o certificado SSL, remova
    # as '#' das duas linhas abaixo para forçar o cadeado seguro:
    # RewriteCond %{HTTPS} off
    # RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
    
    # 2. OCULTAR O .PHP DAS URLs
    # Se quiser que a URL fique "site.com/medplus" em vez de "site.com/medplus.php"
    # remova as '#' destas três linhas abaixo:
    # RewriteCond %{REQUEST_FILENAME} !-f
    # RewriteCond %{REQUEST_FILENAME} !-d
    # RewriteRule ^([^\.]+)$ $1.php [NC,L]
</IfModule>